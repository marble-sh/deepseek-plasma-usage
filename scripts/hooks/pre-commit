#!/bin/sh
# SPDX-FileCopyrightText: 2026 cassidy
# SPDX-License-Identifier: GPL-2.0-or-later
#
# Pre-commit: the quick half of the CI jobs, so an obviously broken commit is caught
# before it is made. Installed by scripts/install-hooks.sh.
#
# `git commit --no-verify` skips it, and CI is the authority either way.
set -u
exec "$(git rev-parse --show-toplevel)/scripts/gauntlet.sh" --fast
