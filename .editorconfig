#
# Editor defaults. Prettier owns the formatting of everything it can parse, and
# `.prettierrc.json` takes precedence over these settings for those files; this
# file covers what Prettier cannot reach -- QML, shell and gettext -- and keeps
# editors from inventing their own indentation.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{js,mjs,cjs,json,qml,sh}]
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab

# JSON, but the generator's own tables, which are two-space like every other
# .json on the internet. The section order is what makes this win.
[translate/messages/*.json]
indent_size = 2

# Generated by translate/generate.mjs; leave their whitespace alone.
[*.{po,pot}]
trim_trailing_whitespace = false
