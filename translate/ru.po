#: contents/config/config.qml contents/ui/ConfigGeneral.qml
msgid "General"
msgstr "Общие"

#: contents/ui/ApiClient.qml
msgid "No session token is stored. Add one in the widget settings."
msgstr "Токен сеанса не сохранён. Добавьте его в настройках виджета."

#: contents/ui/ApiClient.qml
msgid ""
"The session token was rejected. Open platform.deepseek.com, log in and paste a fresh token in the widget settings."
msgstr ""
"Токен сеанса отклонён. Откройте platform.deepseek.com, войдите и вставьте новый токен в настройках виджета."

#: contents/ui/ApiClient.qml
msgid ""
"The platform rejected the request. Try a shorter cost period in the widget settings."
msgstr ""
"Платформа отклонила запрос. Попробуйте более короткий период расходов в настройках виджета."

#: contents/ui/ApiClient.qml
msgid "Add a DeepSeek API key or session token in the widget settings."
msgstr "Добавьте ключ API или токен сеанса DeepSeek в настройках виджета."

#: contents/ui/ApiClient.qml
msgid "Could not read the balance — check the API key."
msgstr "Не удалось прочитать баланс — проверьте ключ API."

#: contents/ui/ApiClient.qml
msgid "The session token was rejected."
msgstr "Токен сеанса отклонён."

#: contents/ui/ApiClient.qml
msgid "HTTP error %1"
msgstr "Ошибка HTTP %1"

#: contents/ui/ApiClient.qml
msgid "Request timed out"
msgstr "Превышено время ожидания запроса"

#: contents/ui/ApiClient.qml
msgid "Network error"
msgstr "Ошибка сети"

#: contents/ui/ApiClient.qml
msgid "never"
msgstr "никогда"

#: contents/ui/ApiClient.qml
msgid "just now"
msgstr "только что"

