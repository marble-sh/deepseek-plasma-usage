msgid "Session token:"
msgstr "Jeton de session :"

#: contents/ui/ConfigGeneral.qml
msgid "Stored in KWallet — enter a new token to replace it"
msgstr "Enregistré dans KWallet — saisissez un nouveau jeton pour le remplacer"

#: contents/ui/ConfigGeneral.qml
msgid "Paste the token from platform.deepseek.com"
msgstr "Collez le jeton depuis platform.deepseek.com"

